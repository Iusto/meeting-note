# Copy to .env. Generate a random owner token (at least 32 characters).
# This is an application login secret, never an external provider API key.
APP_OWNER_TOKEN=replace-with-a-random-owner-token-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-local-database-password
WEB_PORT=8088
# Optional private-access mode only. Set this to the exact MagicDNS hostname
# used by Tailscale Serve, then add compose.tailscale.yaml when starting Compose.
TAILSCALE_HOST=meeting-host.example.ts.net
# Paid providers are an explicit operator opt-in. The private startup script
# ignores this value unless -EnablePaidAi is supplied.
PAID_API_TESTS_ENABLED=false
# Keep provider keys in the process or Windows user environment, not this file.
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
AI_MAXIMUM_AUDIO_SECONDS=14400
# Live app meeting budget is configured in Usage / Budget (DB; initial 3 USD).
# AI_MAXIMUM_MEETING_USD=3.00 # fallback only for standalone configuration
AI_DEEPGRAM_RATE_PER_MINUTE=0.011
AI_PRICE_VERSION=config-record
AI_OPENAI_INPUT_RATE_PER_MILLION=2.00
AI_OPENAI_OUTPUT_RATE_PER_MILLION=10.00
AI_OUTPUT_TOKEN_CAP=2000
AI_TIMEOUT_SECONDS=45
